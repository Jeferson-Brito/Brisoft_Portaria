generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// ORGANIZAÇÕES (Multi-tenant)
// -------------------------------------------------------------
model Organization {
  id          String   @id @default(uuid())
  name        String
  document    String?  // CNPJ / CPF
  slug        String   @unique
  settings    String?  // JSON string para configurações da organização
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  clients            Client[]
  destinations       Destination[]
  visitors           Visitor[]
  visitRequests      VisitRequest[]
  preAuthorizations  PreAuthorization[]
  whatsappConnection WhatsAppConnection?
  messageTemplates   MessageTemplate[]
  auditLogs          AuditLog[]
  systemSettings     SystemSetting[]
  packages           Package[]
  recurringVisitors  RecurringVisitor[]
  accessRestrictions AccessRestriction[]
  amenities          Amenity[]
  amenityBookings    AmenityBooking[]

  @@map("organizations")
}

// -------------------------------------------------------------
// USUÁRIOS & PERFIS (RBAC: ADMIN, SUPERVISOR, CONCIERGE)
// -------------------------------------------------------------
model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String    @unique
  passwordHash   String
  role           String    @default("CONCIERGE") // "ADMIN" | "SUPERVISOR" | "CONCIERGE"
  phone          String?
  clientId       String?
  whatsappNumber String?
  whatsappVerifiedAt DateTime?
  mustCompleteProfile Boolean @default(false)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  visitRequests  VisitRequest[] @relation("ConciergeVisitRequests")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

// -------------------------------------------------------------
// CLIENTES (Morador, Responsável, Médico, Funcionário)
// -------------------------------------------------------------
model Client {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  whatsappNumber String    // Formato E.164: ex. 5511999998888
  email          String?
  document       String?
  company        String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinations       ClientDestination[]
  visitRequests      VisitRequest[]
  preAuthorizations  PreAuthorization[]
  packages           Package[]
  users              User[]
  recurringVisitors  RecurringVisitor[]
  amenityBookings    AmenityBooking[]

  @@index([organizationId])
  @@index([whatsappNumber])
  @@map("clients")
}

// -------------------------------------------------------------
// DESTINOS / UNIDADES (Apto 8, Consultório 3, Setor Financeiro)
// -------------------------------------------------------------
model Destination {
  id             String    @id @default(uuid())
  organizationId String
  name           String    // Ex: "Apartamento 8", "Consultório 3"
  block          String?   // Ex: "Bloco B", "Torre 1"
  code           String?   // Código para busca rápida
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients           ClientDestination[]
  visitRequests     VisitRequest[]
  preAuthorizations PreAuthorization[]
  packages          Package[]
  recurringVisitors RecurringVisitor[]

  @@index([organizationId])
  @@index([code])
  @@map("destinations")
}

// Relação N:N entre Clientes e Destinos
model ClientDestination {
  id            String   @id @default(uuid())
  clientId      String
  destinationId String
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())

  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([clientId, destinationId])
  @@map("client_destinations")
}

// -------------------------------------------------------------
// VISITANTES
// -------------------------------------------------------------
model Visitor {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  documentType   String?   // "CPF" | "RG" | "CNH" | "OUTRO"
  documentNumber String?
  phone          String?
  company        String?   // Ex: "ABC Tecnologia"
  photoUrl       String?   // Caminho no Supabase Storage ou local
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  visitRequests  VisitRequest[]

  @@index([organizationId])
  @@index([documentNumber])
  @@map("visitors")
}

// -------------------------------------------------------------
// VEÍCULOS
// -------------------------------------------------------------
model Vehicle {
  id           String   @id @default(uuid())
  visitorId    String
  model        String   // Ex: "Honda Civic"
  color        String?  // Ex: "Prata"
  licensePlate String?  // Ex: "ABC1D23"
  createdAt    DateTime @default(now())

  visitor       Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitRequests VisitRequest[]

  @@index([licensePlate])
  @@map("vehicles")
}

// -------------------------------------------------------------
// SOLICITAÇÕES DE ACESSO (O CORAÇÃO DO SISTEMA)
// Status: PENDING | AUTHORIZED | DENIED | EXPIRED | CANCELLED | ENTERED | EXITED | FAILED
// -------------------------------------------------------------
model VisitRequest {
  id                 String    @id @default(uuid())
  organizationId     String
  code               String    // Ex: "REQ-2026-000123"
  destinationId      String
  clientId           String
  visitorId          String
  vehicleId          String?
  conciergeUserId    String    // Porteiro criador
  visitorType        String    @default("Visitante") // Prestador, Entregador, Técnico, etc.
  visitReason        String    // Motivo obrigatório: "Visita", "Serviço", "Entrega", etc.
  notes              String?
  status             String    @default("PENDING")
  remindersSentCount Int       @default(0)
  lastReminderAt     DateTime?
  answeredAt         DateTime?
  entryAt            DateTime?
  exitAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destination   Destination  @relation(fields: [destinationId], references: [id])
  client        Client       @relation(fields: [clientId], references: [id])
  visitor       Visitor      @relation(fields: [visitorId], references: [id])
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
  conciergeUser User         @relation("ConciergeVisitRequests", fields: [conciergeUserId], references: [id])
  events        VisitEvent[]

  @@index([organizationId, status])
  @@index([destinationId])
  @@index([clientId])
  @@index([code])
  @@map("visit_requests")
}

// -------------------------------------------------------------
// TIMELINE DE EVENTOS DA VISITA (AUDITORIA IMUTÁVEL)
// -------------------------------------------------------------
model VisitEvent {
  id             String   @id @default(uuid())
  visitRequestId String
  eventType      String   // CREATED, WA_SENT, REMINDER_SENT, AUTHORIZED, DENIED, ENTRY_RECORDED, EXIT_RECORDED, CANCELLED
  description    String
  actorType      String   // "SYSTEM" | "USER" | "WHATSAPP_CLIENT"
  actorId        String?  // ID do usuário ou número de WhatsApp
  metadata       String?  // JSON string com detalhes adicionais
  createdAt      DateTime @default(now())

  visitRequest VisitRequest @relation(fields: [visitRequestId], references: [id], onDelete: Cascade)

  @@index([visitRequestId])
  @@map("visit_events")
}

// -------------------------------------------------------------
// PRÉ-AUTORIZAÇÕES
// -------------------------------------------------------------
model PreAuthorization {
  id                String    @id @default(uuid())
  organizationId    String
  clientId          String
  destinationId     String
  visitorName       String
  visitorDocument   String?
  company           String?
  phone             String?
  visitorType       String    @default("Visitante")
  startDate         DateTime
  endDate           DateTime
  expectedTimeStart String?   // "14:00"
  expectedTimeEnd   String?   // "18:00"
  notes             String?
  vehicleModel      String?
  vehiclePlate      String?
  qrToken           String?
  weekdays          String?   // "2,4" = terça e quinta, no fuso de São Paulo. Vazio = convite de um dia.
  isUsed            Boolean   @default(false)
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id])
  destination  Destination  @relation(fields: [destinationId], references: [id])

  @@index([organizationId, isUsed])
  @@index([qrToken])
  @@map("pre_authorizations")
}

// -------------------------------------------------------------
// CONEXÃO WHATSAPP (BAILEYS)
// -------------------------------------------------------------
model WhatsAppConnection {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  status          String    @default("DISCONNECTED") // DISCONNECTED | CONNECTING | QR_READY | CONNECTED
  phoneConnected  String?
  qrCode          String?   // Base64 ou string do QR
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

// -------------------------------------------------------------
// TEMPLATES DE MENSAGENS CONFIGURÁVEIS
// -------------------------------------------------------------
model MessageTemplate {
  id             String   @id @default(uuid())
  organizationId String
  type           String   // "APPROVAL_REQUEST" | "REMINDER" | "CONFIRMATION"
  title          String
  content        String   // Template com {{cliente}}, {{visitante}}, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@map("message_templates")
}

// -------------------------------------------------------------
// LOGS DE AUDITORIA DO SISTEMA
// -------------------------------------------------------------
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String   // LOGIN, LOGOUT, CREATE_VISIT, AUTHORIZE, DENY, etc.
  entity         String   // User, VisitRequest, Client, etc.
  entityId       String?
  ipAddress      String?
  payload        String?  // JSON string com dados
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// CONFIGURAÇÕES GERAIS DA ORGANIZAÇÃO
// -------------------------------------------------------------
model SystemSetting {
  id             String   @id @default(uuid())
  organizationId String
  key            String   // Ex: "MAX_REMINDERS", "REMINDER_INTERVAL_MINUTES", "REQUEST_TIMEOUT_MINUTES"
  value          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

// -------------------------------------------------------------
// ENCOMENDAS E PACOTES NA PORTARIA (NOVA FASE AVANÇADA)
// -------------------------------------------------------------
model Package {
  id                       String    @id @default(uuid())
  organizationId           String
  destinationId            String
  clientId                 String?
  code                     String    // Ex: "ENC-2026-0001"
  trackingCode             String?   // Ex: "BR123456789"
  carrier                  String?   // "Mercado Livre" | "Amazon" | "Correios" | "Shopee" | "Loggi" | "Outro"
  recipientName            String?   // Nome do morador no pacote
  sender                   String?   // Remetente ou loja
  pickupCode               String    // Código de 4 dígitos para retirada (ex: "7421")
  photoUrl                 String?
  status                   String    @default("RECEIVED") // RECEIVED | PICKED_UP | RETURNED
  conciergeReceivedUserId  String?
  conciergeDeliveredUserId String?
  receivedAt               DateTime  @default(now())
  pickedUpAt               DateTime?
  pickedUpBy               String?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destination  Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([destinationId])
  @@index([code])
  @@index([pickupCode])
  @@map("packages")
}

// Fotos gravadas fora do Prisma (SQL cru). Sem este model o db push
// tenta apagar a tabela no deploy, mesmo com fotos dentro.
model PhotoStorage {
  id        String   @id
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("photo_storage")
}

model RecurringVisitor {
  id             String    @id @default(uuid())
  organizationId String
  clientId       String
  destinationId  String
  visitorName    String
  phone          String?
  weekdays       String
  timeStart      String
  timeEnd        String
  validUntil     DateTime
  qrToken        String?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destination  Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("recurring_visitors")
}

model AccessRestriction {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  documentNumber String?
  reason         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("access_restrictions")
}

model Amenity {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  kind           String   @default("LAZER")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     AmenityBooking[]

  @@index([organizationId])
  @@map("amenities")
}

model AmenityBooking {
  id             String   @id @default(uuid())
  organizationId String
  amenityId      String
  clientId       String
  date           DateTime
  startTime      String
  endTime        String
  status         String   @default("SCHEDULED")
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amenity      Amenity      @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("amenity_bookings")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  phone     String
  purpose   String
  codeHash  String
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@map("verification_codes")
}

// Registro permanente do teste grátis. Não some quando a empresa é apagada.
model TrialClaim {
  id              String   @id @default(uuid())
  documentDigits  String   @unique
  emailNormalized String   @unique
  createdAt       DateTime @default(now())

  @@map("trial_claims")
}
