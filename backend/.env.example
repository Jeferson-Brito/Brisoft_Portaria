# -------------------------------------------------------------
# CONFIGURAÇÕES DO SERVIDOR & BACKEND
# -------------------------------------------------------------
PORT=3333
NODE_ENV=development
API_URL=http://localhost:3333

# -------------------------------------------------------------
# BANCO DE DADOS (SUPABASE POSTGRESQL)
# -------------------------------------------------------------
# Exemplo Supabase:
# Modo Transaction Pooling (porta 6543) para a aplicação:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Modo Direct Connection (porta 5432) para migrations do Prisma:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# -------------------------------------------------------------
# Em produção o servidor recusa o valor padrão. Use segredos diferentes, com 32+ caracteres.
JWT_SECRET="sua_chave_secreta_jwt_super_segura_deve_ter_minimo_32_caracteres"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="sua_chave_secreta_refresh_token_super_segura"
JWT_REFRESH_EXPIRES_IN="7d"

# Origens extras do navegador, separadas por vírgula. O app mobile não depende disso.
# CORS_ORIGINS="https://portaria.brisoft.com.br"

# -------------------------------------------------------------
# SUPABASE STORAGE (FOTOS DE VISITANTES E DOCUMENTOS)
# -------------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_do_supabase"
SUPABASE_BUCKET_VISITORS="visitor-photos"

# -------------------------------------------------------------
# WHATSAPP / BAILEYS
# -------------------------------------------------------------
WHATSAPP_SESSION_PATH="./whatsapp_sessions"
WHATSAPP_AUTO_RECONNECT=true

# -------------------------------------------------------------
# NOTIFICAÇÕES PUSH
# -------------------------------------------------------------
EXPO_ACCESS_TOKEN=""

# -------------------------------------------------------------
# SUPER_ADMIN DO SAAS (credenciais do dono da plataforma)
# Configure antes de executar: npm run prisma:super-admin
# -------------------------------------------------------------
SUPER_ADMIN_EMAIL="superadmin@brisoft.com.br"
SUPER_ADMIN_PASSWORD="SuaSenhaForteAqui@2026!"
SUPER_ADMIN_NAME="Administrador Brisoft Portaria"
